{
	"$schema": "./node_modules/knip/schema.json",
	"bun": true,
	"ignoreDependencies": [
		"@lerna-lite/publish",
		"@lerna-lite/version",
		"conventional-changelog-conventionalcommits",
		"lefthook",
		"mutative"
	],
	"workspaces": {
		"packages/*": {
			"entry": ["src/index.ts", "test/**/*.test.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"]
		}
	}
}
