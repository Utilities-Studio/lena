{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@lena/ai": ["./packages/ai/src/index"],
      "@lena/backup": ["./packages/backup/src/index"],
      "@lena/core": ["./packages/core/src/index"],
      "@lena/expo-sqlite": ["./packages/expo-sqlite/src/index"],
      "@lena/google-drive": ["./packages/google-drive/src/index"],
      "@lena/gps": ["./packages/gps/src/index"],
      "@lena/icloud": ["./packages/icloud/src/index"],
      "@lena/manual-backup": ["./packages/manual-backup/src/index"],
      "@lena/op-sqlite": ["./packages/op-sqlite/src/index"],
      "@lena/search": ["./packages/search/src/index"],
      "@lena/storekit": ["./packages/storekit/src/index"],
      "@lena/sync": ["./packages/sync/src/index"],
      "@lena/vault": ["./packages/vault/src/index"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "types": ["bun"],
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["packages/*/dist"],
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "tsdown.config.ts"]
}
