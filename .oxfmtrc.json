{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": ["packages/*/dist/**", "packages/*/CHANGELOG.md"],
	"arrowParens": "always",
	"semi": false,
	"singleQuote": true,
	"tabWidth": 2,
	"trailingComma": "none",
	"useTabs": true,
	"printWidth": 80,
	"sortPackageJson": false
}
